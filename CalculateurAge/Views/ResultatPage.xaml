<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.Views.ResultatPage"
             Title="Résultat">

    <VerticalStackLayout Padding="30" Spacing="16">
        <StackLayout>
            <Label Text="{Binding Nom, StringFormat='Nom: {0}'}" FontSize="18" FontAttributes="Bold"/>
            <Label Text="{Binding Age, StringFormat='Âge: {0} ans'}" FontSize="18"/>
            <Label Text="{Binding Message, StringFormat='Status: {0}'}" FontSize="16" FontAttributes="Bold" TextColor="Green"/>
            <Label Text="{Binding InfoAnniversaire}" FontSize="14"/>
        </StackLayout>
        <Button Text="Retour" Command="{Binding RetourCommand}"/>
    </VerticalStackLayout>

</ContentPage>